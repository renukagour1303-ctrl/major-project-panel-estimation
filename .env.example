# ============================================================
# Sungroves Innovations LLP - Solar Calculator Web Tool
# Environment Configuration Template
# ============================================================
# Copy this file to .env in backend/ or root for local development.
# Do NOT commit actual API keys or secrets to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# External Solar Resource APIs (Backend only)
PVGIS_API_URL=https://re.jrc.ec.europa.eu/api/v5_3/PVcalc
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/monthly/point

# AI Explanation Layer (Backend only - Anthropic Claude API)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here

# Geocoding Service (Backend only - Nominatim)
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:5000/api
