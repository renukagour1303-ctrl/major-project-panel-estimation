# ============================================================
# Sungroves Innovations LLP - Solar Calculator Backend
# Environment Configuration Template
# ============================================================
# Copy this file to .env in this backend/ directory for local development.
# Do NOT commit actual API keys or secrets to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# External Solar Resource APIs
PVGIS_API_URL=https://re.jrc.ec.europa.eu/api/v5_3/PVcalc
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/monthly/point

# AI Explanation Layer (Anthropic Claude API)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here

# Geocoding Service (Nominatim)
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# SMTP Configuration (Mailtrap Email Sandbox for Development - STARTTLS)
# Host: sandbox.smtp.mailtrap.io
# Port: 587
# Secure: false (STARTTLS upgrade)
# Auth: LOGIN or PLAIN
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_sandbox_username
SMTP_PASS=your_mailtrap_sandbox_password
SMTP_FROM="Sungroves Support <no-reply@sungroves.in>"

# Frontend Application Base URL (Used for constructing password-reset links in emails)
FRONTEND_URL=http://localhost:5173

# Razorpay Configuration (Test Mode)
ENABLE_RAZORPAY=true
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
